# generated load packages (too large for git — use .dvc pointers instead)
/load-packages/small/
/load-packages/small-errors/
/load-packages/broken-load-files/
/load-packages/medium/
/load-packages/large/
/load-packages/xlarge/
/load-packages/*.zip

# OCR content cache (generated by build_load_package.py)
.ocr-content-cache.json

# generated mock data for medium/large tiers (too large for git — hosted as releases)
# The generated tiers themselves are too large for git, but their .dvc pointers
# are the only thing that says where a tier lives, so they have to be tracked.
# Ignoring the directory outright silently swallowed thirteen new pointers, and a
# pointer that is not committed is a `make mock-*` target that cannot resolve.
# Excluding the contents rather than the directory is what lets the negation work.
/mock-data/medium/*
!/mock-data/medium/*.dvc
/mock-data/large/*
!/mock-data/large/*.dvc
/mock-data/xlarge/*
!/mock-data/xlarge/*.dvc
/mock-data/small-edge/

# actual data files — tracked by DVC, not git
/data-products/*.csv
/data-products/*.zip
/data-products/*.gz
/data-products/*.txt
/metadata/*.parquet
/samples/*.zip
/manifest.tsv.gz

# raw document archive (16 single-letter prefix directories)
/[a-z]/

# DVC internals
.dvc/cache
.dvc/tmp

# misc
*.pyc
__pycache__/
.DS_Store
