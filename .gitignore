# generated load packages (too large for git — use .dvc pointers instead)
/load-packages/small/
/load-packages/small-errors/
/load-packages/medium/
/load-packages/large/
/load-packages/*.zip

# OCR content cache (generated by build_load_package.py)
.ocr-content-cache.json

# generated mock data for medium/large tiers (too large for git — hosted as releases)
/mock-data/medium/
/mock-data/large/

# actual data files — tracked by DVC, not git
/data-products/*.csv
/data-products/*.zip
/data-products/*.gz
/data-products/*.txt
/metadata/*.parquet
/samples/*.zip
/manifest.tsv.gz

# raw document archive (16 single-letter prefix directories)
/[a-z]/

# DVC internals
.dvc/cache
.dvc/tmp

# misc
*.pyc
__pycache__/
.DS_Store
